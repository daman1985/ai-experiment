generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// The three participating model providers. Deliberately not "personas" --
// agents are labeled by what they actually are, never given invented
// human names or backstories (see HurumoAI precedent in project docs).
enum Provider {
  ANTHROPIC
  OPENAI
  GOOGLE
}

enum RunStatus {
  DRAFT // created but not started -- keys/budgets not yet confirmed
  ACTIVE
  PAUSED // manually paused by admin
  STOPPED_BUDGET // auto-stopped: an agent (or the run) hit its budget cap
  STOPPED_MANUAL
  COMPLETED
}

enum DecisionMethod {
  CONSENSUS // all active agents signaled ready_to_decide with no forced vote
  MAJORITY_VOTE // round cap was hit; resolved by explicit vote
}

enum DocumentKind {
  TEXT // content is the raw/extracted text, injected as prompt text
  IMAGE // content is base64-encoded image bytes, sent as multimodal content
}

// Encrypted API keys + default model/budget config, set once via the
// admin settings page. One row per provider. Keys are AES-256-GCM
// encrypted with a server-side key (ENCRYPTION_KEY env var) -- never
// stored or transmitted in plaintext, never sent to the client.
//
// Pricing is admin-entered rather than hardcoded in application code:
// provider rate cards change often and this app has no reliable way to
// fetch them live, so cost tracking would silently drift out of date if
// baked into a constants file. The settings page should link out to each
// provider's current pricing page and ask the admin to confirm the rate
// before a run starts.
model ProviderConfig {
  id                    String   @id @default(cuid())
  provider              Provider @unique
  encryptedApiKey       String
  iv                    String
  authTag               String
  defaultModelId        String
  inputPricePerMillion  Decimal  @db.Decimal(10, 4)
  outputPricePerMillion Decimal  @db.Decimal(10, 4)
  updatedAt             DateTime @updatedAt
}

model Run {
  id     String    @id @default(cuid())
  name   String?
  // What the room is actually discussing -- free text, admin-supplied at
  // creation. The only content-steering input the admin gives: no phases,
  // stages, or per-topic guidance are defined ahead of time. Whether and
  // how the room breaks this into stages, assigns roles, or organizes
  // itself is left entirely to the agents -- see docs/design-system.md,
  // "Full autonomy, not admin-scripted phases."
  topic  String
  status RunStatus @default(DRAFT)

  // Rounds of back-and-forth allowed since the last decision (or since the
  // run started, if there hasn't been one yet) before a forced vote --
  // mechanical pacing, not content steering. Compared against
  // activeAgents.length so it scales with room size.
  forcedVoteRoundCap Int     @default(6)
  // Whether agents get the web-search tool. A single run-wide toggle --
  // there's no admin-defined stage to hang a per-stage version off of
  // anymore, and the cost/capability tradeoff doesn't depend on topic
  // content.
  allowsResearch     Boolean @default(true)

  // Round-robin turn order is derived, not stored: the Nth turn since the
  // last decision goes to activeAgents[N mod activeAgents.length], with
  // the starting seat rotated by round to avoid a permanent first-mover
  // advantage (see lib/agents/engine.ts). A yield substitutes a named
  // agent into that slot for one tick instead of adding an extra turn, so
  // every active agent still gets exactly one turn per lap regardless of
  // how many yields happened along the way. pendingYieldToAgentId is the
  // only rotation state that actually needs to persist between ticks;
  // roundNumber is a cached display value, recomputed from the turn count
  // on every tick, not authoritative.
  pendingYieldToAgentId String?
  roundNumber           Int     @default(0)
  forcedVotePending     Boolean @default(false)

  // The round-cap "turns since the last decision" window is measured from
  // here instead of from the last Decision when this is more recent --
  // set to the run's current max Turn.sequenceNumber whenever the admin
  // manually extends a run (see extendRoundsAction), which is how "give
  // it N more rounds" and "un-complete this and keep going" both work
  // without needing separate mechanisms.
  extendedAtSequenceNumber Int @default(0)

  // Guards advanceRun against overlapping invocations -- the cron tick and
  // an admin's "watch live" polling (see LiveWatchToggle) can otherwise
  // race to take the same turn, paying for two LLM calls when only one
  // turn gets recorded (the second loses on Turn's [runId, sequenceNumber]
  // unique constraint). Claimed atomically at the top of advanceRun and
  // released in a finally block; a lock older than STALE_LOCK_MS is
  // treated as an abandoned lock from a crashed invocation and reclaimed
  // rather than left stuck forever.
  isAdvancing    Boolean   @default(false)
  advancingSince DateTime?

  // Soft ceiling on total run spend, independent of each agent's own cap --
  // belt and suspenders in case per-agent tracking drifts. Compared against
  // sum(agent.spendUsd) + systemSpendUsd.
  totalBudgetCapUsd Decimal @default(90) @db.Decimal(10, 2)
  // Infra cost not attributed to any one agent -- e.g. the small extraction
  // call used to summarize a consensus or tally a forced vote into a clean
  // Decision record. Deliberately not counted against any agent's own
  // budget cap since it's plumbing, not a participant's contribution.
  systemSpendUsd    Decimal @default(0) @db.Decimal(10, 6)

  createdAt DateTime  @default(now())
  startedAt DateTime?
  endedAt   DateTime?

  agents    Agent[]
  turns     Turn[]
  decisions Decision[]
  artifacts Artifact[]
  documents Document[]
}

// Admin-uploaded context, introduced at any point during an active run --
// distinct from Artifact (agent-produced collateral): a Document is
// always admin-sourced input, never retroactively rewritten into turns
// that already happened, and can be scoped to only some agents rather
// than always being universally visible.
model Document {
  id       String       @id @default(cuid())
  runId    String
  run      Run          @relation(fields: [runId], references: [id], onDelete: Cascade)
  filename String
  mimeType String
  kind     DocumentKind
  // TEXT: the extracted/raw text itself. IMAGE: base64-encoded bytes --
  // stored as text rather than Bytes since every provider's multimodal
  // content format wants base64 anyway, so there's no conversion to do
  // at either write or read time.
  content  String

  // true (default) = every agent in the run, present and any added
  // later, can see this. false = only the agents in accessAgentIds can.
  sharedWithAll  Boolean @default(true)
  accessAgentIds Json? // string[] of Agent.id -- read only when sharedWithAll is false

  // The run's max Turn.sequenceNumber at the moment this was uploaded.
  // Turns already spoken before this point never see it; every later
  // turn from an agent with access gets it injected into their prompt.
  introducedAfterSequenceNumber Int

  createdAt DateTime @default(now())
}

model Agent {
  id    String @id @default(cuid())
  runId String
  run   Run    @relation(fields: [runId], references: [id], onDelete: Cascade)

  provider    Provider
  displayName String // "Claude" / "GPT" / "Gemini" -- real identity, not a persona
  modelId     String
  seatIndex   Int // fixed rotation order, 0..2

  budgetCapUsd Decimal @default(30) @db.Decimal(10, 2)
  spendUsd     Decimal @default(0) @db.Decimal(10, 6)

  // False once this agent's budget cap is hit or it errors out repeatedly;
  // skipped in rotation but its turns remain in the transcript.
  isActive Boolean @default(true)

  createdAt DateTime @default(now())

  turnsAsSpeaker Turn[]     @relation("TurnAgent")
  turnsYieldedTo Turn[]     @relation("TurnYieldTarget")
  artifacts      Artifact[]

  @@unique([runId, seatIndex])
  @@unique([runId, provider])
}

// One turn = one agent's contribution during its speaking slot. The
// weaknessCritique field is mandatory by design, not optional -- it's the
// structural counter to multi-agent sycophancy/convergence: an agent has
// to name a real weakness in the current proposal before it's allowed to
// signal agreement via readyToDecide.
model Turn {
  id      String @id @default(cuid())
  runId   String
  run     Run    @relation(fields: [runId], references: [id], onDelete: Cascade)
  agentId String
  agent   Agent  @relation("TurnAgent", fields: [agentId], references: [id])

  roundNumber    Int
  sequenceNumber Int // global monotonic order within the run

  message          String
  weaknessCritique String

  // Self-reported confidence in the current leading position, before and
  // after this turn's exposure to peers' prior turns -- lets the admin
  // (and eventually a decision-map view) distinguish "I reached this
  // independently" from "I changed because peers said so," rather than
  // treating any agreement as evidence of good-faith convergence. Private
  // telemetry: never replayed back into other agents' prompt context, so
  // it can't itself become something to conform on.
  confidenceBeforePeerUpdate Float
  confidenceAfterPeerUpdate  Float

  readyToDecide  Boolean @default(false)
  // True only when this agent believes the entire topic is now fully
  // resolved and the room's work is done, not just that this particular
  // decision is ready -- see the ground rules in lib/agents/prompt.ts.
  // Checked only once readyToDecide is unanimous; almost always false.
  runComplete    Boolean @default(false)
  yieldToAgentId String?
  yieldToAgent   Agent?  @relation("TurnYieldTarget", fields: [yieldToAgentId], references: [id])

  isVote     Boolean @default(false)
  voteChoice String?

  // Web search (or other read-only research tool) calls made during this
  // turn, logged for transparency -- query + result summary, not raw HTML.
  toolCalls Json?

  inputTokens  Int
  outputTokens Int
  costUsd      Decimal @db.Decimal(10, 6)

  createdAt DateTime @default(now())

  artifacts Artifact[]

  @@unique([runId, sequenceNumber])
}

model Decision {
  id      String @id @default(cuid())
  runId   String
  run     Run    @relation(fields: [runId], references: [id], onDelete: Cascade)
  outcome String // e.g. the chosen approach, or the full role assignment
  method    DecisionMethod
  dissent   Json? // { agentId: string, reason: string }[] when not unanimous

  // The highest Turn.sequenceNumber that existed in the run when this
  // decision resolved. The conversation is one continuous transcript with
  // no phase resets, so this is how the engine finds "turns since the
  // last decision" for round-cap purposes without re-scoping anything by
  // phase.
  afterSequenceNumber Int

  // Automated pre-mortem, extracted once when the decision resolves --
  // a structural analog to an "enhancing cognition"-style re-evaluation
  // gate (name the load-bearing assumption, name the failure mode) run
  // once over the finished decision rather than added as another
  // per-turn field, so it can't become another box a weak model
  // perfunctorily checks. Admin-facing only -- never replayed back into
  // the agents' own prompt context, same reasoning as the confidence
  // fields on Turn.
  untestedAssumption String
  likelyFailureMode  String

  decidedAt DateTime       @default(now())
}

// Generic collateral produced along the way -- deliberately untyped beyond
// a free-form "type" string, since what the agents choose to build is not
// known in advance (landing page copy, a business plan doc, marketing
// drafts, anything else). Never anything that gets sent anywhere real.
model Artifact {
  id               String  @id @default(cuid())
  runId            String
  run              Run     @relation(fields: [runId], references: [id], onDelete: Cascade)
  type             String
  title            String
  content          String
  createdByAgentId String?
  createdByAgent   Agent?  @relation(fields: [createdByAgentId], references: [id])
  // The turn that produced this artifact, if any -- lets the UI show an
  // inline preview at the moment of creation and link the separate
  // Artifacts section back to that point in the transcript.
  turnId           String?
  turn             Turn?   @relation(fields: [turnId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
