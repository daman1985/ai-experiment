# Postgres connection string (Vercel Postgres / Neon, or any Postgres).
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# AES-256-GCM key for encrypting provider API keys at rest, base64-encoded,
# must decode to exactly 32 bytes. Generate with: openssl rand -base64 32
ENCRYPTION_KEY=""

# The password you type in at /admin/login.
ADMIN_PASSWORD=""

# A separate long random secret used for the session cookie -- never typed
# in anywhere, distinct from ADMIN_PASSWORD. Generate with: openssl rand -hex 32
ADMIN_SESSION_SECRET=""

# Shared secret Vercel Cron sends as `Authorization: Bearer <value>` when it
# calls /api/cron/tick. Generate with: openssl rand -hex 32
CRON_SECRET=""
